# Optional: use an existing local Ollama installation when its service is down.
# The migrated private.json already remembers this computer's downloaded runtime.
# OLLAMA_EXECUTABLE=C:/path/to/ollama.exe
# OLLAMA_MODELS=C:/path/to/ollama/models

# Add upstream provider keys through the localhost:3001 dashboard.
# Its login/client key lives in ignored data/gateway/private.json.
